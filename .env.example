# Configuración del Cliente Supabase (Públicas)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Edge Functions & Hashing (Servidor / Edge)
# HMAC key para duplicados de documentos de beneficiarios (nunca exponer en el frontend)
DOCUMENT_HMAC_SECRET=super-secret-hmac-key-change-in-production

# Adaptador de Pasarela de Pagos (Deshabilitado por defecto para el MVP)
VITE_ENABLE_REAL_PAYMENTS=false
PAYMENT_GATEWAY_PROVIDER=adapter_stub
PAYMENT_GATEWAY_SECRET_KEY=stub_secret_key
